                ]
              }
            }
          ]
        },
        {
          "name": "GET /inventory/{productId} → stock sin cambios (11)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventoryUrl}}/inventory/{{productId}}",
              "host": [
                "{{inventoryUrl}}"
              ],
              "path": [
                "inventory",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El intento fallido no descontó nada', () => pm.expect(pm.response.json().stockActual).to.eql(11));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Caso 5 - Consultar historial de ventas",
      "item": [
        {
          "name": "GET /sales → listado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{salesUrl}}/sales",
              "host": [
                "{{salesUrl}}"
              ],
              "path": [
                "sales"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const ventas = pm.response.json();",
                  "pm.test('Listado de ventas registradas', () => pm.expect(ventas).to.be.an('array').that.is.not.empty);",
                  "pm.test('Incluye la venta del Caso 3', () => pm.expect(ventas.map(v => v.id)).to.include(Number(pm.collectionVariables.get('saleId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /sales/{id} → detalle",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{salesUrl}}/sales/{{saleId}}",
              "host": [
                "{{salesUrl}}"
              ],
              "path": [
                "sales",
                "{{saleId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Detalle con subtotal', () => { const v = pm.response.json(); pm.expect(v.detalles).to.have.length(1); pm.expect(v.detalles[0].cantidad).to.eql(4); });"
                ]
              }
            }
          ]
        }
      ]
    },
